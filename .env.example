# Copy this file to ".env" (same folder) and fill in your real values.
# ".env" is git-ignored, so your password never gets pushed to GitHub.
#
# Get the connection string from MongoDB Atlas -> Clusters -> Connect -> Drivers.
# If your password has special characters (@ : / ? # %), URL-encode them.
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/?appName=<app-name>

# Signs login tokens. Any random string of 32+ characters, e.g. from:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<random-string-of-at-least-32-characters>

# Only needed for seed_data.py (it logs in as admin to create faculty accounts)
SEED_ADMIN_USERNAME=<your-admin-username>
SEED_ADMIN_PASSWORD=<your-admin-password>
